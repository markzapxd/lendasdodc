{
  "name": "lendas-do-dc",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "db:start": "pnpm supabase start",
    "db:stop": "pnpm supabase stop",
    "db:reset": "pnpm supabase db reset",
    "db:push": "pnpm supabase db push",
    "db:migrate": "pnpm supabase migration list",
    "db:types": "pnpm supabase gen types typescript --local > src/types/database.generated.ts",
    "db:test": "pnpm supabase test db",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:env:start": "echo 'Test env started'",
    "test:env:smoke": "node -e \"import('./tests/support/test-env.mjs').then(m => console.log('OK:', m.testEnv.RUN_ID))\"",
    "test:env:stop": "echo 'Test env stopped'",
    "design:lint": "npx tsx scripts/validate-design.ts",
    "doctor": "npx react-doctor@latest",
    "ci:validate": "pnpm exec biome check . && pnpm exec tsc --noEmit && pnpm test:unit && pnpm build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "@supabase/supabase-js": "^2.112.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "ioredis": "^6.0.0",
    "playwright": "^1.62.1",
    "react-doctor": "^0.9.3",
    "react-grab": "^0.1.50",
    "react-scan": "^0.5.7",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "uuid": "^14.0.1",
    "vitest": "^4.1.10"
  }
}
